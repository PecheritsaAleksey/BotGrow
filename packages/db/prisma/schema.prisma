datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Message templates & steps enums
enum StepType {
  TEXT
  PHOTO
  DOCUMENT
  VIDEO
}

enum ParseMode {
  NONE
  MarkdownV2
  HTML
}

model User {
  id          String   @id @default(uuid())
  telegramId  Int      @unique
  username    String?
  firstName   String
  lastName    String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bots        Bot[]    @relation("UserBots")
}

model Bot {
  id             String   @id @default(uuid())
  userId         String
  name           String
  description    String?  @db.Text
  photoUrl       String?
  encryptedToken String
  tokenHash      String
  tokenLast4     String   @default("")
  status         String   @default("disconnected")
  webhookUrl     String?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(name: "UserBots", fields: [userId], references: [id], onDelete: Cascade)

  // Subscribers relation (implicit backreference)
  // Not required for functionality but useful for querying
  subscribers Subscriber[]

  // Message templates relations
  welcomeMessageId String?
  welcomeMessage   MessageTemplate?  @relation("WelcomeForBot", fields: [welcomeMessageId], references: [id])
  messages         MessageTemplate[] @relation("TemplatesOfBot")

  @@index([userId])
  @@index([tokenHash])
  @@index([welcomeMessageId], map: "idx_bot_welcome_message_id")
}

model Subscriber {
  id         String   @id @default(uuid())
  botId      String
  telegramId Int
  username   String?
  firstName  String?
  lastName   String?
  language   String?
  photoUrl   String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, telegramId])
  @@index([botId])
  @@index([botId, lastSeenAt])
}

model MessageTemplate {
  id         String   @id @default(uuid())
  botId      String
  bot        Bot      @relation("TemplatesOfBot", fields: [botId], references: [id], onDelete: Cascade)
  title      String
  locale     String?
  isArchived Boolean  @default(false)

  steps      MessageStep[]

  // Opposite side of Bot.welcomeMessage
  welcomedByBots Bot[] @relation("WelcomeForBot")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([botId], map: "idx_template_bot_id")
  @@index([updatedAt], map: "idx_template_updated_at")
}

model MessageStep {
  id             String          @id @default(uuid())
  templateId     String
  template       MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  order          Int
  type           StepType
  parseMode      ParseMode       @default(NONE)

  text           String?
  mediaUrl       String?
  fileId         String?
  disablePreview Boolean         @default(true)
  keyboardJson   Json?
  delayMs        Int             @default(0)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([templateId, order], map: "idx_step_template_order")
}
